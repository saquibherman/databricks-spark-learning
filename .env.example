# Copy to .env and adjust (setup.sh does this). Loaded automatically by VS Code Jupyter kernels;
# in a terminal: `set -a; . ./.env; set +a`.
# Profile in ~/.databrickscfg used for local runs (Databricks Connect, pytest).
# databricks-cli auth reads the CLI's OAuth token cache directly; it does not use the VS Code
# extension's local auth helper, whose address goes stale after reloads ('metadata-service ... refused').
DATABRICKS_CONFIG_PROFILE=azure-de
DATABRICKS_AUTH_TYPE=databricks-cli

# Local Spark sessions run on serverless compute
DATABRICKS_SERVERLESS_COMPUTE_ID=auto
